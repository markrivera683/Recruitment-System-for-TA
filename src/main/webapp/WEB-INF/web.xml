<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
  <display-name>TA Recruitment System</display-name>
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>login</welcome-file>
  </welcome-file-list>

  <listener>
    <listener-class>com.bupt.ta.persistence.AppInitListener</listener-class>
  </listener>

  <filter>
    <filter-name>CsrfFilter</filter-name>
    <filter-class>com.bupt.ta.security.CsrfFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>CsrfFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Explicit mapping so /mo works even if annotation scanning misses @WebServlet -->
  <servlet>
    <servlet-name>MoServlet</servlet-name>
    <servlet-class>com.bupt.ta.servlet.MoServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>MoServlet</servlet-name>
    <url-pattern>/mo</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>MoApplicantProfileServlet</servlet-name>
    <servlet-class>com.bupt.ta.servlet.MoApplicantProfileServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>MoApplicantProfileServlet</servlet-name>
    <url-pattern>/mo/applicant-profile</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CvDownloadServlet</servlet-name>
    <servlet-class>com.bupt.ta.servlet.CvDownloadServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CvDownloadServlet</servlet-name>
    <url-pattern>/cv</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AiStreamServlet</servlet-name>
    <servlet-class>com.bupt.ta.servlet.AiStreamServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AiStreamServlet</servlet-name>
    <url-pattern>/api/ai/stream</url-pattern>
  </servlet-mapping>
    <!-- Custom error pages -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
</web-app>
